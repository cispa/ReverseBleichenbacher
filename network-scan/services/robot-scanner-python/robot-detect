def identical_results(results):
    values = list(results.values())
    return all(value == values[0] for value in values[1:])


def format_result_set(label, results, ran):
    if not ran or results is None:
        return f"{label}: not run"
    return f"{label}: good={results['good']}, bad1={results['bad1']}, bad2={results['bad2']}, bad3={results['bad3']}, bad4={results['bad4']}"


